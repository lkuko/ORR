.community-note { display: flex; align-items: center; gap: 22rpx; margin-top: 28rpx; padding: 24rpx; border-radius: 20rpx; background: #e6f1ea; }
.chat-symbol { display: flex; flex: none; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; color: #34715b; background: #fff; border-radius: 22rpx 22rpx 22rpx 6rpx; font-size: 28rpx; font-weight: 700; }
.community-title, .community-description { display: block; }
.community-title { font-size: 28rpx; font-weight: 600; }
.community-description { margin-top: 6rpx; font-size: 23rpx; color: #537663; }
.feed { border: 1rpx solid #e4e9f3; border-radius: 16rpx; background: #fff; overflow: hidden; }
.post-card { padding: 30rpx 28rpx; border-bottom: 1rpx solid #e9edf5; }
.post-card:last-child { border-bottom: 0; }
.post-author-row { display: flex; align-items: center; gap: 16rpx; }
.post-author-copy { min-width: 0; }
.post-author { display: block; font-size: 26rpx; font-weight: 600; overflow-wrap: break-word; }
.post-time { display: block; margin-top: 4rpx; color: #66738a; font-size: 22rpx; }
.post-content { display: -webkit-box; margin: 24rpx 0; overflow: hidden; font-size: 29rpx; line-height: 1.8; white-space: pre-wrap; overflow-wrap: break-word; -webkit-line-clamp: 5; -webkit-box-orient: vertical; }
.post-footer { display: flex; align-items: center; gap: 12rpx; color: #66738a; font-size: 23rpx; }
.comment-symbol { width: 27rpx; height: 23rpx; border: 2rpx solid #8191ad; border-radius: 7rpx 7rpx 7rpx 0; }
.open-mark { margin-left: auto; color: #2854d9; font-weight: 600; }
