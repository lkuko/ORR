<view class="page">
  <view class="hero-row"><view><text class="page-title">校园圈</text><text class="page-subtitle">小消息、新发现，和同学聊一聊。</text></view><button class="primary-button compact-button" bindtap="createPost" hover-class="button-pressed">发帖</button></view>
  <view wx:if="{{demoMode}}" class="mode-note">演示数据仅保存在当前设备</view>
  <view class="community-note"><view class="chat-symbol" aria-hidden="true">聊</view><view><text class="community-title">校园里的事，一起说说</text><text class="community-description">分享信息，也请尊重彼此的隐私。</text></view></view>
  <view class="section-heading"><text>最新讨论</text><text class="muted">{{loading ? '更新中' : posts.length + ' 篇'}}</text></view>
  <view wx:if="{{loading && posts.length === 0}}" class="loading-panel"><view class="loading-line"></view><view class="loading-line short"></view><text class="loading-label">正在读取校园消息…</text></view>
  <empty-state wx:elif="{{error}}" title="讨论暂时没能加载" description="{{error}}" button-text="重新加载" bind:action="load" />
  <empty-state wx:elif="{{posts.length === 0}}" title="第一条校园消息，等你来发" description="问个问题，或分享一件刚发现的小事。" button-text="发起讨论" bind:action="createPost" />
  <view wx:else class="feed">
    <view wx:for="{{posts}}" wx:key="id" class="post-card" data-id="{{item.id}}" bindtap="openPost" hover-class="button-pressed" role="button" aria-label="查看{{item.authorNickname}}的帖子">
      <view class="post-author-row"><view class="avatar">{{item.authorInitial}}</view><view class="post-author-copy"><text class="post-author">{{item.authorNickname}}</text><text class="post-time">{{item.createdLabel}}</text></view></view>
      <text class="post-content">{{item.content}}</text>
      <view class="post-footer"><view class="comment-symbol" aria-hidden="true"></view><text>{{item.commentCount ? item.commentCount + ' 条评论' : '说说你的想法'}}</text><text class="open-mark">参与讨论</text></view>
    </view>
  </view>
</view>
