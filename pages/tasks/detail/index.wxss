.detail-header { padding: 8rpx 0 26rpx; }
.detail-meta, .detail-line { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.task-category { color: #2854d9; font-size: 24rpx; font-weight: 600; }
.detail-title { display: block; margin-top: 20rpx; font-size: 40rpx; font-weight: 700; line-height: 1.45; overflow-wrap: break-word; }
.detail-hint { display: block; margin-top: 16rpx; color: #52658c; font-size: 25rpx; line-height: 1.6; }
.detail-section { margin-top: 20rpx; padding: 28rpx; border: 1rpx solid #e4e9f3; border-radius: 16rpx; background: #fff; }
.reward-line { display: flex; align-items: baseline; gap: 18rpx; color: #2854d9; font-size: 38rpx; font-weight: 700; }
.settlement { color: #66738a; font-size: 22rpx; font-weight: 400; }
.detail-description { display: block; margin-top: 22rpx; font-size: 28rpx; line-height: 1.75; white-space: pre-wrap; overflow-wrap: break-word; }
.detail-section-title { display: block; margin-bottom: 14rpx; font-size: 29rpx; font-weight: 700; }
.detail-line { align-items: flex-start; padding: 20rpx 0; border-bottom: 1rpx solid #edf0f6; font-size: 25rpx; }
.detail-line:last-child { border-bottom: 0; }
.fact-name { flex: none; color: #66738a; }
.fact-value { min-width: 0; max-width: 67%; text-align: right; overflow-wrap: break-word; }
.privacy-note { display: block; padding: 18rpx 0; color: #52658c; font-size: 24rpx; line-height: 1.6; }
.cancel-reason { margin-top: 20rpx; padding: 20rpx; border-radius: 14rpx; color: #91531f; background: #fff3dc; font-size: 25rpx; line-height: 1.6; overflow-wrap: break-word; }
.report-button { min-height: 80rpx; margin-top: 20rpx; padding: 16rpx 0; background: transparent; color: #66738a; font-size: 24rpx; font-weight: 400; }
.message-panel { padding: 24rpx; border: 1rpx solid #e4e9f3; border-radius: 16rpx; background: #fff; }
.message-empty { padding: 20rpx 0; color: #66738a; font-size: 25rpx; }
.message-row { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 20rpx; }
.message-row.mine { align-items: flex-end; }
.message-author { margin-bottom: 6rpx; color: #66738a; font-size: 21rpx; }
.message-content { max-width: 86%; padding: 16rpx 20rpx; border-radius: 18rpx 18rpx 18rpx 5rpx; background: #f1f4fb; line-height: 1.6; overflow-wrap: break-word; }
.message-row.mine .message-content { border-radius: 18rpx 18rpx 5rpx 18rpx; background: #e8efff; }
.message-composer { display: flex; gap: 12rpx; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f6; }
.message-composer input { min-width: 0; height: 86rpx; flex: 1; padding: 0 18rpx; border: 1rpx solid #dfe5f0; border-radius: 12rpx; background: #f8faff; }
.message-composer button { flex: none; width: 160rpx; min-height: 86rpx; padding: 18rpx 8rpx; font-size: 25rpx; }
