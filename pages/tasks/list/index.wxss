.tasks-page { padding-top: 20rpx; }
.dispatch { position: relative; overflow: hidden; padding: 34rpx 32rpx; border-radius: 28rpx; background: #2854d9; color: #fff; }
.dispatch-copy { position: relative; z-index: 1; }
.dispatch-title { display: block; font-size: 50rpx; font-weight: 700; line-height: 1.3; }
.dispatch-description { display: block; max-width: 78%; margin-top: 12rpx; color: #e5ecff; font-size: 24rpx; line-height: 1.7; }
.publish-button { display: inline-flex; align-items: center; gap: 10rpx; margin-top: 28rpx; padding: 18rpx 28rpx; border-radius: 14rpx; background: #f4d269; color: #293a55; min-height: 84rpx; font-size: 27rpx; }
.dispatch button.publish-button { width: auto; }
.plus { font-size: 34rpx; font-weight: 400; line-height: 1; }
.route-art { position: absolute; right: 27rpx; bottom: 28rpx; width: 170rpx; height: 135rpx; transform: rotate(-9deg); }
.route-line { position: absolute; width: 115rpx; height: 67rpx; border-right: 3rpx dashed #b4c8ff; border-bottom: 3rpx dashed #b4c8ff; border-radius: 0 0 36rpx 0; left: 22rpx; top: 29rpx; }
.route-stop { position: absolute; display: flex; align-items: center; justify-content: center; width: 45rpx; height: 45rpx; border-radius: 14rpx; font-size: 22rpx; font-weight: 600; }
.start { left: 0; bottom: 16rpx; color: #2854d9; background: #fff; }
.finish { right: 9rpx; top: 0; color: #fff; border: 2rpx solid #b4c8ff; }
.route-package { position: absolute; left: 35rpx; top: 10rpx; width: 43rpx; height: 43rpx; border: 2rpx solid #b4c8ff; border-radius: 6rpx; }
.route-package view { width: 11rpx; height: 18rpx; border: 2rpx solid #b4c8ff; border-top: 0; margin: 0 auto; }
.search-box { display: flex; align-items: center; gap: 20rpx; padding: 0 24rpx; margin: 26rpx 0 22rpx; height: 94rpx; border: 1rpx solid #e1e7e5; border-radius: 16rpx; background: #fff; }
.search-icon { position: relative; width: 26rpx; height: 26rpx; flex: none; border: 3rpx solid #8191ad; border-radius: 50%; }
.search-icon::after { position: absolute; content: ''; width: 12rpx; height: 3rpx; right: -9rpx; bottom: -5rpx; background: #8191ad; transform: rotate(45deg); }
.search-box input { flex: 1; min-width: 0; font-size: 25rpx; height: 88rpx; }
.search-placeholder { color: #7c89a0; }
.clear-search { display: flex; align-items: center; justify-content: center; min-height: 80rpx; width: 60rpx; padding: 0; background: transparent; font-size: 36rpx; color: #66738a; }
.category-strip { width: 100%; white-space: nowrap; }
.category-list { display: flex; width: max-content; gap: 12rpx; }
.category-item { display: inline-flex; flex: none; align-items: center; justify-content: center; min-height: 80rpx; padding: 16rpx 27rpx; border-radius: 14rpx; background: transparent; color: #66738a; font-size: 25rpx; font-weight: 500; white-space: nowrap; }
.category-item.selected { background: #e4ebff; color: #244dbf; font-weight: 700; }
