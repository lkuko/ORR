<view class="page">
  <view class="hero-row"><view><text class="page-title">每一单，都有着落。</text><text class="page-subtitle">发布的需求，接下的托付，都在这里。</text></view></view>
  <view class="segmented-control"><button class="segment {{role === 'owner' ? 'active' : ''}}" data-role="owner" bindtap="selectRole">我发布的</button><button class="segment {{role === 'helper' ? 'active' : ''}}" data-role="helper" bindtap="selectRole">我接单的</button></view>
  <view class="order-filters"><button wx:for="{{filters}}" wx:key="value" class="filter {{filter === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</button></view>
  <view wx:if="{{loading && tasks.length === 0}}" class="loading-panel"><view class="loading-line"></view><view class="loading-line short"></view><text class="loading-label">正在读取订单进度…</text></view>
  <empty-state wx:elif="{{error}}" title="订单暂时没能加载" description="{{error}}" button-text="重新加载" bind:action="load" />
  <empty-state wx:elif="{{tasks.length === 0}}" title="{{filter === 'all' ? '还没有这类订单' : '这个状态下还没有订单'}}" description="{{role === 'owner' ? '把需要帮忙的小事，交给顺路的同学。' : '去跑腿大厅看看，有没有顺路的任务。'}}" button-text="{{role === 'owner' ? '发布任务' : '去跑腿大厅'}}" bind:action="emptyAction" />
  <view wx:else>
    <view wx:for="{{tasks}}" wx:key="id" class="order-row" data-id="{{item.id}}" bindtap="openTask" hover-class="button-pressed" role="button" aria-label="{{item.title}}，{{item.statusLabel}}">
      <view class="order-top"><status-tag status="{{item.status}}" /><text class="order-number">订单 #{{item.id}}</text></view>
      <text class="order-title">{{item.title}}</text>
      <view class="order-info"><text class="order-area">{{item.publicArea}}</text><text class="order-reward">{{item.rewardLabel}}</text></view>
      <view class="order-next"><text>{{item.nextHint}}</text><text class="chevron">›</text></view>
    </view>
  </view>
</view>
