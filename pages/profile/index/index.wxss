.profile-card { margin-top: 30rpx; padding: 30rpx; border: 1rpx solid #eedfad; border-radius: 16rpx; background: #fff3d4; }
.profile-top { display: flex; align-items: center; gap: 24rpx; }
.profile-initial { display: flex; flex: none; width: 100rpx; height: 100rpx; align-items: center; justify-content: center; border-radius: 30rpx; background: #fff; color: #8b5b15; font-size: 44rpx; font-weight: 700; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { display: block; font-size: 34rpx; font-weight: 700; overflow-wrap: break-word; }
.profile-note { display: block; margin-top: 8rpx; font-size: 24rpx; color: #765e33; }
.edit-profile { margin-top: 24rpx; min-height: 80rpx; padding: 18rpx; border-radius: 14rpx; background: #fff; color: #2854d9; font-size: 25rpx; }
.profile-card button.edit-profile { width: auto; padding-left: 28rpx; padding-right: 28rpx; display: inline-block; }
.quick-orders { display: flex; gap: 20rpx; }
.quick-order { flex: 1; min-width: 0; padding: 28rpx; text-align: left; background: #fff; border: 1rpx solid #e4e9f3; border-radius: 16rpx; }
.quick-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-bottom: 18rpx; background: #eaf0ff; color: #2854d9; border-radius: 16rpx; font-size: 26rpx; }
.helper-icon { background: #fff3d4; color: #8b5b15; }
.quick-title, .quick-note { display: block; }
.quick-title { font-size: 30rpx; font-weight: 650; }
.quick-note { margin-top: 8rpx; color: #66738a; font-size: 23rpx; font-weight: 400; }
.safety-panel { padding: 4rpx 28rpx; }
.safety-row { padding: 24rpx 0; border-bottom: 1rpx solid #edf0f6; }
.safety-row:last-child { border-bottom: 0; }
.safety-title, .safety-copy { display: block; }
.safety-title { font-size: 27rpx; font-weight: 600; }
.safety-copy { margin-top: 8rpx; color: #66738a; font-size: 24rpx; line-height: 1.7; }
.demo-switch { margin-top: 24rpx; }
.profile-loading { margin-top: 28rpx; }
