:host { display: block; margin-bottom: 20rpx; }
.task { padding: 28rpx; border: 1rpx solid #e4e9f3; border-radius: 16rpx; background: #fff; color: #182744; }
.pressed { background: #f8faff; }
.heading, .category, .footer { display: flex; align-items: center; }
.heading { justify-content: space-between; gap: 18rpx; }
.category { gap: 12rpx; color: #2854d9; font-size: 24rpx; font-weight: 600; }
.category-mark { display: flex; justify-content: center; align-items: center; width: 48rpx; height: 48rpx; border-radius: 14rpx; background: #edf2ff; font-size: 24rpx; }
.category-FOOD { color: #996218; }
.category-FOOD .category-mark { background: #fff3d9; }
.category-ERRAND { color: #37695e; }
.category-ERRAND .category-mark { background: #eaf5f0; }
.category-OTHER { color: #705698; }
.category-OTHER .category-mark { background: #f1edfa; }
.reward { display: flex; align-items: flex-end; flex-direction: column; flex: none; color: #2854d9; font-size: 36rpx; font-weight: 700; line-height: 1.25; font-variant-numeric: tabular-nums; }
.settlement { margin-top: 6rpx; color: #66738a; font-size: 20rpx; font-weight: 400; }
.title { display: block; margin-top: 18rpx; font-size: 32rpx; font-weight: 700; line-height: 1.5; overflow-wrap: break-word; }
.description { display: -webkit-box; margin-top: 10rpx; color: #66738a; font-size: 26rpx; line-height: 1.6; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.location { display: flex; align-items: center; gap: 12rpx; margin: 24rpx 0; color: #465777; font-size: 24rpx; }
.waypoint { flex: none; width: 15rpx; height: 15rpx; border: 4rpx solid #8093ba; border-radius: 50%; }
.area { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.footer { gap: 14rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f6; font-size: 22rpx; color: #66738a; }
.owner { max-width: 28%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.time { flex: 1; }
.detail-link { flex: none; color: #2854d9; font-weight: 600; }
