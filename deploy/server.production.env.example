# Example only. Store the real file outside the source checkout.
NODE_ENV=production
PORT=3000
BIND_HOST=0.0.0.0
TRUST_PROXY_HOPS=2
API_BASE_PATH=/api/v1
WEB_ORIGIN=https://admin.example.com
WECHAT_APP_ID=replace-with-your-app-id
WECHAT_APP_SECRET=replace-with-your-app-secret
WECHAT_LOGIN_MODE=wechat
CONTENT_CHECK_MODE=wechat
TOKEN_SECRET=replace-with-at-least-32-random-characters
DB_HOST=replace-with-rds-private-endpoint
DB_PORT=3306
DB_NAME=campus_runner
DB_USER=campus_runner
DB_PASSWORD=replace-with-database-password
DB_CONNECTION_LIMIT=10
ADMIN_USERNAME=admin
