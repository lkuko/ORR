.reports-heading { display: flex; align-items: center; gap: 16rpx; }
.reports-heading > view { flex: 1; min-width: 0; }
.reports-page .clear-all { flex: none; width: auto; padding: 18rpx 16rpx; background: #fff; color: #aa3e3e; font-size: 24rpx; }
.reports-tip { display: flex; align-items: flex-start; gap: 12rpx; padding: 20rpx 22rpx; margin: 26rpx 0; border-radius: 12rpx; color: #806640; background: #fff3d4; font-size: 23rpx; line-height: 1.6; }
.reports-tip > text:first-child { flex: none; font-size: 28rpx; }
.cleanup-progress { display: block; margin-bottom: 22rpx; color: #64748b; font-size: 24rpx; }
.report-record { padding: 26rpx 26rpx 0; border: 1rpx solid #e4eaf3; border-radius: 22rpx; background: #fff; }
.report-highlight { border-color: #2854d9; }
.record-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.record-title { font-size: 30rpx; font-weight: 600; }
.report-status { flex: none; padding: 6rpx 14rpx; border-radius: 8rpx; color: #806640; background: #fff3d4; font-size: 23rpx; }
.status-RESOLVED { color: #34715b; background: #e6f1ea; }
.status-DISMISSED { color: #64748b; background: #f1f5fb; }
.target-summary { display: block; margin-top: 22rpx; padding: 18rpx 20rpx; border-left: 4rpx solid #dfe5f0; color: #52617a; background: #f8faff; font-size: 25rpx; line-height: 1.7; white-space: pre-wrap; }
.target-fallback { display: block; margin-top: 18rpx; color: #64748b; font-size: 23rpx; }
.record-section { margin-top: 22rpx; }
.record-label, .record-content, .record-time, .result-title, .result-content { display: block; }
.record-label { color: #64748b; font-size: 23rpx; }
.record-content { margin-top: 6rpx; font-size: 27rpx; white-space: pre-wrap; line-height: 1.7; }
.record-time { margin-top: 8rpx; font-size: 22rpx; color: #75849a; }
.record-result { margin-top: 22rpx; padding: 20rpx; border-radius: 12rpx; background: #f1f5fb; }
.result-title { font-size: 24rpx; font-weight: 600; color: #52617a; }
.result-content { margin-top: 8rpx; color: #52617a; font-size: 25rpx; line-height: 1.7; white-space: pre-wrap; }
.record-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.record-footer .record-time { flex: 1; margin: 0; }
.reports-page .clear-one { flex: none; min-width: 100rpx; padding: 22rpx 0 22rpx 16rpx; background: transparent; color: #aa3e3e; font-size: 24rpx; font-weight: 400; }
.record-limit { display: block; margin: 24rpx 0; color: #75849a; font-size: 23rpx; text-align: center; }

.reports-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; color: #52617a; font-size: 25rpx; }
.reports-tip { margin-top: 12rpx; }
.report-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.record-footer { flex-wrap: wrap; }
.reports-page .delete-report { color: #64748b; }
.reports-page .restore-report { width: auto; min-height: 80rpx; margin: 8rpx 0; padding: 20rpx; background: #eaf0ff; color: #2854d9; font-size: 25rpx; border-radius: 12rpx; }
.report-expiry { display: block; margin-top: 16rpx; color: #806640; font-size: 23rpx; }
