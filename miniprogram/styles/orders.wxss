@import "./reports.wxss";
.order-center { padding-top: 20rpx; }
.center-heading { margin-bottom: 28rpx; }
.order-controls { margin-bottom: 24rpx; padding: 10rpx 20rpx 16rpx; background: #fff; border: 1rpx solid #e4eaf3; border-radius: 24rpx; }
.kind-tabs { display: flex; gap: 12rpx; border-bottom: 1rpx solid #edf1f7; }
.order-center .kind-tab { display: flex; align-items: center; justify-content: center; gap: 12rpx; flex: 1; min-width: 0; margin: 0; padding: 22rpx 4rpx; background: transparent; color: #64748b; border-radius: 0; border-bottom: 5rpx solid transparent; font-size: 30rpx; }
.kind-tab text { font-size: 34rpx; }
.order-center .kind-tab.selected { color: #2854d9; border-bottom-color: #2854d9; }
.role-tabs { display: flex; gap: 8rpx; margin-top: 16rpx; padding: 6rpx; border-radius: 16rpx; background: #f1f5fb; }
.order-center .role-tabs button { flex: 1; min-width: 0; min-height: 84rpx; padding: 20rpx 4rpx; border-radius: 12rpx; background: transparent; color: #64748b; font-size: 27rpx; }
.order-center .role-tabs .selected { color: #152c48; background: #fff; box-shadow: 0 3rpx 10rpx rgba(25,49,87,.07); }
.status-tabs { display: flex; gap: 6rpx; padding-top: 8rpx; }
.order-center .status-tabs button { flex: 1; min-width: 0; padding: 22rpx 0 12rpx; min-height: 80rpx; color: #64748b; background: transparent; font-size: 25rpx; font-weight: 400; }
.order-center .status-tabs .selected { color: #2854d9; font-weight: 700; }
.toolbar-title, .toolbar-note { display: block; }
.toolbar-title { color: #152c48; font-size: 26rpx; font-weight: 600; }
.toolbar-note { margin-top: 6rpx; color: #64748b; font-size: 22rpx; }
.cleanup-progress { margin-bottom: 20rpx; padding: 20rpx; color: #64748b; font-size: 24rpx; }
.order-card { overflow: hidden; border: 1rpx solid #e4eaf3; border-radius: 22rpx; background: #fff; }
.order-main { padding: 26rpx 26rpx 0; }
.order-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.order-number { color: #75849a; font-size: 22rpx; }
.trade-status { flex: none; padding: 6rpx 12rpx; border-radius: 8rpx; color: #2854d9; background: #eaf0ff; font-size: 22rpx; }
.status-CANCEL_PENDING, .status-DISPUTED { color: #8b5b15; background: #fff3d4; }
.status-COMPLETED { color: #34715b; background: #e6f1ea; }
.status-CANCELLED { color: #64748b; background: #f1f5fb; }
.order-title-row { display: flex; align-items: flex-start; gap: 20rpx; margin-top: 22rpx; }
.order-title { flex: 1; min-width: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: #152c48; font-size: 31rpx; line-height: 1.5; font-weight: 650; }
.order-price { flex: none; max-width: 42%; color: #b7452b; font-size: 32rpx; font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
.order-person { display: block; margin-top: 10rpx; color: #64748b; font-size: 24rpx; }
.order-next { margin-top: 22rpx; padding: 18rpx 20rpx; background: #f4f7fd; color: #52617a; border-radius: 12rpx; font-size: 24rpx; line-height: 1.65; }
.archive-hint { background: #fff8e9; color: #806640; }
.order-footer { padding: 20rpx 26rpx 24rpx; }
.order-date { display: block; color: #75849a; font-size: 21rpx; }
.order-center .load-more { width: 100%; margin-top: 24rpx; background: #fff; color: #2854d9; }

.order-center .kind-tabs { gap: 4rpx; }
.order-center .kind-tab { font-size: 28rpx; }
