@import "../vendor/colorui/main.wxss";
page { background: #f1f5fb; color: #152c48; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; --blue: #2854d9; --blueLight: #e9efff; font-size: 28rpx; }
.market-page { padding: 32rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); min-height: 100vh; }
.market-page .cu-btn { width: auto; min-width: 0; min-height: 88rpx; height: auto; padding: 20rpx 28rpx; font-size: 28rpx; font-weight: 600; border-radius: 16rpx; line-height: 1.5; margin: 0; }
.market-page .submit-button { width: 100%; }
.market-page .text-button { width: auto; margin: 0; flex: none; }
.market-page .cu-btn.sm { min-height: 72rpx; padding: 16rpx 24rpx; font-size: 25rpx; }
.market-page .cu-tag { height: auto; min-height: 40rpx; line-height: 1.5; padding: 4rpx 12rpx; font-size: 22rpx; border-radius: 6rpx; }
.market-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 32rpx; }
.market-heading > view { min-width: 0; flex: 1; }
.market-heading > button { flex: none; }
.market-title { display: block; font-size: 44rpx; font-weight: 700; line-height: 1.3; }
.market-note { display: block; margin-top: 8rpx; color: #66738a; font-size: 24rpx; line-height: 1.6; }
.market-search { display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx; background: #fff; border: 2rpx solid #dbe3e7; border-radius: 16rpx; }
.market-search input { flex: 1; min-width: 0; height: 92rpx; font-size: 28rpx; }
.market-search button { flex: none; width: 64rpx; min-width: 64rpx; min-height: 80rpx; margin: 0; padding: 8rpx; background: transparent; font-size: 30rpx; }
.market-search .cuIcon-search { color: #66738a; font-size: 34rpx; }
.market-categories { width: 100%; margin: 24rpx 0 16rpx; white-space: nowrap; }
.market-categories .category-row { display: inline-flex; gap: 12rpx; }
.market-page .category-row button { flex: none; background: #fff; color: #52617a; border-radius: 12rpx; }
.market-page .category-row button.selected { background: #2854d9; color: #fff; }
.market-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx 16rpx; margin: 24rpx 0; }
.market-toolbar > .market-note { flex: none; margin: 0; white-space: nowrap; font-size: 22rpx; }
.market-sort { display: flex; flex: none; gap: 24rpx; }
.market-sort button { flex: none; width: auto; min-width: 0; margin: 0; padding: 8rpx 0; background: transparent; color: #66738a; min-height: 72rpx; font-size: 26rpx; border-radius: 0; border-bottom: 4rpx solid transparent; }
.market-sort button.selected { color: #2854d9; border-bottom-color: #2854d9; }
.product-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24rpx 16rpx; }
.market-more { margin: 32rpx auto 0; text-align: center; color: #66738a; font-size: 24rpx; }
.market-page .market-more button { width: 100%; }
.market-error { margin: 24rpx 0; padding: 24rpx; border-radius: 12rpx; background: #fff0ef; color: #a73b3b; font-size: 25rpx; }
.market-section { margin-top: 24rpx; padding: 28rpx; background: #fff; border: 1rpx solid #e4eaf3; border-radius: 16rpx; }
.market-section-title { display: block; font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.market-price { color: #b7452b; font-size: 44rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.market-facts { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 16rpx; color: #66738a; font-size: 24rpx; }
.market-paragraph { display: block; white-space: pre-wrap; word-break: break-all; line-height: 1.8; font-size: 28rpx; }
.market-actions { display: flex; align-items: stretch; gap: 16rpx; margin-top: 24rpx; }
.market-actions > button { flex: 1; min-width: 0; width: auto; margin: 0; }
.market-actions .favorite-button { flex: 0 0 140rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12rpx; gap: 4rpx; font-size: 22rpx; background: #e9efff; color: #244dbf; }
.favorite-button text:first-child { font-size: 34rpx; }
.market-meta { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex-wrap: wrap; padding-top: 16rpx; color: #66738a; font-size: 23rpx; }
.market-meta .text-button { min-height: 72rpx; font-size: 23rpx; }
.product-tools { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
.product-tools > text { grid-column: 1 / -1; }
.market-page .product-tools .text-button { width: 100%; min-width: 0; margin: 0; background: #f5f7fc; }
.market-empty { padding: 64rpx 16rpx; text-align: center; }
.market-empty .cuIcon-shop { font-size: 64rpx; color: #8c9baf; }
.market-empty strong, .market-empty .empty-title { display: block; font-size: 30rpx; margin: 24rpx 0 8rpx; font-weight: 600; }
.market-page button[disabled] { background: #e3e8f3 !important; color: #69768e !important; }
.market-page text { overflow-wrap: anywhere; }
@media (prefers-reduced-motion: reduce) { .market-page, .market-page .cu-btn, .market-page .cu-tag { animation: none; transition: none; } }
