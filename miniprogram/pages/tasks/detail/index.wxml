<view class="page" wx:if="{{task}}">
  <view class="detail-header"><view class="detail-meta"><text class="task-category">{{task.categoryLabel}}</text><status-tag status="{{task.status}}" /></view><text class="detail-title">{{task.title}}</text><text wx:if="{{!showCancellation}}" class="detail-hint">{{nextHint}}</text></view>
  <view class="detail-section"><view class="reward-line"><text>{{task.rewardLabel}}</text><text wx:if="{{task.hasReward}}" class="settlement">双方线下结算</text></view><text class="detail-description">{{task.description}}</text></view>
  <view class="detail-section facts"><text class="detail-section-title">任务信息</text><view class="detail-line"><text class="fact-name">发布者</text><text class="fact-value">{{task.ownerNickname}}</text></view><view wx:if="{{task.helperNickname}}" class="detail-line"><text class="fact-name">接单者</text><text class="fact-value">{{task.helperNickname}}</text></view><view class="detail-line"><text class="fact-name">大致区域</text><text class="fact-value">{{task.publicArea}}</text></view><view wx:if="{{task.canSeeExactLocation}}" class="detail-line"><text class="fact-name">具体地点</text><text class="fact-value">{{task.exactLocation}}</text></view><view wx:else class="privacy-note">具体地点在接单后仅向订单双方开放</view><view wx:if="{{task.deadlineLabel}}" class="detail-line"><text class="fact-name">截止时间</text><text class="fact-value">{{task.deadlineLabel}}</text></view><view class="detail-line"><text class="fact-name">发布时间</text><text class="fact-value">{{task.createdLabel}}</text></view></view>
  <view wx:if="{{task.status === 'OPEN' && !task.expired && !isOwner}}" class="action-row"><button class="primary-button" bindtap="accept">接单</button></view>
  <view wx:if="{{task.status === 'OPEN' && isOwner}}" class="action-row"><button class="danger-button" bindtap="cancelOpenTask">取消任务</button></view>
  <view wx:if="{{task.status === 'ASSIGNED' && isHelper}}" class="action-row"><button class="primary-button" bindtap="markComplete">标记完成</button></view>
  <view wx:if="{{task.status === 'COMPLETION_PENDING' && isOwner}}" class="action-row"><button class="primary-button" bindtap="confirmComplete">确认完成</button></view>
  <view wx:if="{{(task.status === 'ASSIGNED' || task.status === 'COMPLETION_PENDING') && isParticipant}}" class="action-row"><button class="danger-button" bindtap="requestCancel">申请取消</button></view>
  <view wx:if="{{showCancellation}}" class="cancel-panel">
    <text class="cancel-title">取消申请</text>
    <text class="cancel-label">申请原因</text>
    <text class="cancel-reason">{{task.cancelReason}}</text>
    <text class="cancel-hint">{{nextHint}}</text>
    <view wx:if="{{canDecideCancel}}" class="action-row"><button class="secondary-button" disabled="{{acting}}" data-accepted="false" bindtap="decideCancel">拒绝取消</button><button class="danger-button" disabled="{{acting}}" data-accepted="true" bindtap="decideCancel">同意取消</button></view>
  </view>
  <view wx:if="{{task.status === 'OPEN' && task.expired}}" class="privacy-note">任务已超过截止时间，无法接单。</view>
  <view class="task-tools">
    <view class="order-reference"><text class="reference-label">订单编号</text><text class="reference-number">{{orderNumber}}</text></view>
    <view class="task-tool-actions"><button class="task-tool copy-number" bindtap="copyOrderNumber" aria-label="复制完整订单编号">复制编号</button><button class="task-tool report-button" bindtap="report">举报任务</button></view>
  </view>
  <view wx:if="{{isParticipant && (task.canArchive || task.archived)}}" class="detail-section"><text class="muted">{{task.archived ? '记录已移入回收站，可恢复至 ' + task.expiresLabel : '已结束的订单可移入个人回收站。'}}</text><view class="record-action-row"><button wx:if="{{task.archived}}" class="record-action record-secondary" data-action="restore" bindtap="changeRecord" disabled="{{acting}}" loading="{{acting}}">恢复记录</button><button wx:else class="record-action record-danger" data-action="archive" bindtap="changeRecord" disabled="{{acting}}" loading="{{acting}}">删除记录</button></view></view>
  <view wx:if="{{isParticipant}}" class="section-heading"><text>订单留言</text><text class="muted">仅订单双方可见</text></view>
  <view wx:if="{{isParticipant}}" class="message-panel"><view wx:if="{{messages.length === 0}}" class="message-empty">还没有留言</view><view wx:for="{{messages}}" wx:key="id" class="message-row {{item.senderId === userId ? 'mine' : ''}}"><text class="message-author">{{item.senderNickname}}</text><text class="message-content">{{item.content}}</text></view><view wx:if="{{task.status !== 'COMPLETED' && task.status !== 'CANCELLED'}}" class="inline-composer message-composer"><input class="composer-input" value="{{message}}" maxlength="500" placeholder="写一条订单留言" disabled="{{sendingMessage}}" confirm-type="send" bindconfirm="sendMessage" bindinput="onMessageInput" /><button class="primary-button composer-send" loading="{{sendingMessage}}" disabled="{{sendingMessage}}" bindtap="sendMessage">发送</button></view></view>
</view>
<view wx:else class="page"><view wx:if="{{loading}}" class="loading-panel"><view class="loading-line short"></view><view class="loading-line"></view><text class="loading-label">正在读取任务…</text></view><empty-state wx:else title="任务暂时无法打开" description="{{error || '请稍后重试。'}}" button-text="重新加载" bind:action="load" /></view>
