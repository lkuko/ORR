<view class="market-page"><view class="market-heading"><view><text class="market-title">我的闲置</text><text class="market-note">管理发布，也把喜欢的好物留下。</text></view><button class="cu-btn bg-blue sm" bindtap="publish">发布</button></view><view class="market-sort"><button class="{{mode === 'mine' ? 'selected' : ''}}" data-mode="mine" bindtap="select">我的发布</button><button class="{{mode === 'favorites' ? 'selected' : ''}}" data-mode="favorites" bindtap="select">我的收藏</button></view><view class="market-toolbar"><text class="market-note">{{mode === 'mine' ? '点进商品可查看详情或管理上下架' : '点击收藏图标可移出收藏夹'}}</text></view><view wx:if="{{loading && !products.length}}" class="loading-panel"><text class="loading-label">正在读取…</text></view><empty-state wx:elif="{{error && !products.length}}" title="暂时未能读取" description="{{error}}" button-text="重试" bind:action="load"/><empty-state wx:elif="{{!products.length}}" title="{{mode === 'mine' ? '还没有发布闲置' : '收藏夹还是空的'}}" description="{{mode === 'mine' ? '拍几张照片，让闲置找到下一位主人。' : '看到喜欢的商品，点一下星标即可收藏。'}}" button-text="逛逛校园二手" bind:action="discover"/><view class="product-grid"><product-card wx:for="{{products}}" wx:key="id" product="{{item}}" busy="{{favoritesBusy[item.id]}}" bind:open="open" bind:favorite="favorite"/></view><text wx:if="{{error && products.length}}" class="error-text">{{error}}</text><view class="market-more"><button wx:if="{{cursor}}" class="cu-btn bg-white" loading="{{loading}}" disabled="{{loading}}" bindtap="loadMore">加载更多</button></view></view>
