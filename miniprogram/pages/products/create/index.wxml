<view class="market-page">
  <view class="market-heading"><view><text class="market-title">让闲置继续发光</text><text class="market-note">真实照片、如实描述，交接更放心。</text></view></view>
  <view class="market-section"><view class="photo-heading"><text class="market-section-title">商品照片 {{images.length}}/6</text><button class="text-button" loading="{{checking}}" disabled="{{checking}}" bindtap="refreshImages">刷新检查</button></view>
    <view class="photo-grid"><view wx:for="{{images}}" wx:key="id" class="photo-item"><image src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="preview"/><button class="photo-remove" data-index="{{index}}" bindtap="remove" disabled="{{submitting}}" aria-label="移除第{{index + 1}}张图片"><text class="cuIcon-close"></text></button><text class="photo-status {{item.status === 'PASSED' ? 'passed' : ''}}">{{item.label}}</text><button wx:if="{{item.status === 'ERROR'}}" class="photo-retry" data-id="{{item.id}}" bindtap="retryImage" disabled="{{checking}}">重新检查</button></view><button wx:if="{{images.length < 6}}" class="photo-add" bindtap="choose" loading="{{uploading}}" disabled="{{uploading || submitting}}"><text class="cuIcon-cameraadd"></text><text>{{uploading ? '压缩上传中' : '添加照片'}}</text></button></view>
    <text class="field-hint">第一张作为封面。自动压缩，最多 6 张；安全检查通常稍后完成，最长约 30 分钟。</text><text wx:if="{{uploadError}}" class="error-text">{{uploadError}}</text>
  </view>
  <view class="market-section"><view class="field"><text class="field-label">商品标题</text><input class="field-input" value="{{title}}" maxlength="60" data-field="title" bindinput="input" placeholder="例如：九成新高等数学教材"/></view><view class="field"><text class="field-label">商品描述</text><textarea class="field-area" value="{{description}}" maxlength="2000" data-field="description" bindinput="input" placeholder="写清型号、使用情况、瑕疵及附带物品"/></view><view class="form-columns"><view class="field"><text class="field-label">分类</text><picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="category"><view class="field-select">{{categories[categoryIndex].label}}<text class="cuIcon-unfold"></text></view></picker></view><view class="field"><text class="field-label">成色</text><picker range="{{conditions}}" range-key="label" value="{{conditionIndex}}" bindchange="condition"><view class="field-select">{{conditions[conditionIndex].label}}<text class="cuIcon-unfold"></text></view></picker></view></view></view>
  <view class="market-section"><view class="field"><text class="field-label">价格（元）</text><input class="field-input" type="digit" value="{{price}}" maxlength="8" data-field="price" bindinput="input" placeholder="0.00"/></view><view class="field"><text class="field-label">公开交易区域</text><input class="field-input" value="{{publicArea}}" maxlength="80" data-field="publicArea" bindinput="input" placeholder="例如：图书馆门口"/><text class="field-hint">会展示给所有同学，请勿填写宿舍房间号或私人联系方式。</text></view></view>
  <view wx:if="{{error}}" class="market-error">{{error}}</view><button class="cu-btn bg-blue submit-button" disabled="{{submitting || uploading}}" loading="{{submitting}}" bindtap="submit">{{submitting ? '正在发布' : '发布商品'}}</button><text class="form-note">双方当面验货、线下结算，平台不代收费用。</text>
</view>
