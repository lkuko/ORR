@import "../../../styles/market.wxss";
.photo-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.photo-heading .market-section-title { margin: 0; }
.market-page .photo-add, .market-page .photo-retry { width: 100%; }
.market-page .photo-remove { width: 72rpx; }
.photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16rpx; margin: 16rpx 0; }
.photo-item { position: relative; }
.photo-item image, .photo-add { width: 100%; height: 176rpx; border-radius: 12rpx; background: #edf1f6; }
.photo-remove { position: absolute; right: 0; top: 0; width: 72rpx; min-height: 72rpx; padding: 12rpx; margin: 0; background: rgba(32,49,55,.8); color: #fff; font-size: 28rpx; border-radius: 0 12rpx 0 12rpx; }
.photo-status { display: block; color: #98601b; font-size: 21rpx; padding: 8rpx 0; }
.photo-status.passed { color: #26704b; }
.photo-add { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 8rpx; padding: 16rpx 8rpx; font-size: 23rpx; color: #52617a; border: 2rpx dashed #bfcbdc; }
.photo-add text:first-child { font-size: 40rpx; }
.photo-retry { min-height: 72rpx; margin: 0; padding: 8rpx; background: #e9efff; color: #2854d9; font-size: 22rpx; }
.form-columns { display: flex; gap: 16rpx; }
.form-columns .field { flex: 1; min-width: 0; margin-top: 28rpx; }
.field-select { display: flex; gap: 8rpx; align-items: center; justify-content: space-between; padding-left: 16rpx; padding-right: 16rpx; font-size: 26rpx; }
