@import "../../../styles/market.wxss";
.product-detail { padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.product-dock { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e1e7e5; box-shadow: 0 -4rpx 18rpx rgba(32,49,55,.06); }
.product-dock-note { display: block; margin-bottom: 14rpx; font-size: 23rpx; color: #66738a; }
.product-dock .market-actions { margin-top: 0; }
.product-dock .market-actions > button { min-width: 0; padding-left: 12rpx; padding-right: 12rpx; }
.product-gallery { height: 600rpx; border-radius: 16rpx; background: #fff; overflow: hidden; }
.gallery-image { width: 100%; height: 100%; }
.price-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.detail-title { display: block; margin-top: 16rpx; font-size: 36rpx; line-height: 1.5; font-weight: 600; word-break: break-all; }
