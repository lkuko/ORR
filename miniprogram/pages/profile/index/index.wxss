.profile-page { padding-top: 32rpx; }
.profile-header { display: flex; align-items: center; gap: 22rpx; padding: 8rpx 0 32rpx; }
.profile-initial { display: flex; flex: none; width: 100rpx; height: 100rpx; align-items: center; justify-content: center; border-radius: 30rpx; background: #2854d9; color: #fff; font-size: 42rpx; font-weight: 700; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { display: block; color: #152c48; font-size: 36rpx; font-weight: 700; overflow-wrap: anywhere; }
.profile-note { display: block; margin-top: 6rpx; font-size: 24rpx; color: #64748b; }
.profile-page .edit-profile { flex: none; display: flex; align-items: center; gap: 8rpx; width: auto; min-width: 88rpx; padding: 16rpx 8rpx; background: transparent; color: #64748b; font-size: 24rpx; font-weight: 400; }
.profile-orders { padding: 24rpx 26rpx 8rpx; background: #fff; border: 1rpx solid #e4eaf3; border-radius: 24rpx; }
.profile-orders .section-heading { margin: 0 0 8rpx; font-size: 30rpx; }
.profile-page .order-shortcut { display: flex; align-items: center; gap: 18rpx; width: 100%; min-width: 0; padding: 22rpx 0; text-align: left; background: transparent; border-radius: 0; }
.order-shortcut + .order-shortcut { border-top: 1rpx solid #edf1f7; }
.order-shortcut > view:nth-child(2) { flex: 1; min-width: 0; }
.shortcut-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 20rpx; background: #eaf0ff; color: #2854d9; font-size: 38rpx; }
.shortcut-title, .shortcut-note, .entry-title, .entry-note { display: block; }
.shortcut-title { color: #152c48; font-size: 29rpx; font-weight: 600; }
.shortcut-note { margin-top: 4rpx; color: #64748b; font-size: 23rpx; font-weight: 400; }
.profile-page .profile-entry { display: flex; align-items: center; gap: 18rpx; width: 100%; min-width: 0; padding: 26rpx; background: #fff; border-radius: 0; text-align: left; }
.entry-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 48rpx; color: #2854d9; font-size: 36rpx; }
.entry-copy { flex: 1; min-width: 0; }
.entry-title { color: #152c48; font-size: 28rpx; font-weight: 600; }
.entry-note { margin-top: 5rpx; color: #64748b; font-size: 23rpx; font-weight: 400; line-height: 1.55; }
.entry-chevron { flex: none; color: #8a99ad; font-size: 36rpx; font-weight: 400; }
.profile-page .report-entry { margin-top: 24rpx; border: 1rpx solid #eedfad; border-radius: 22rpx; background: #fff3d4; }
.report-entry .entry-icon, .report-entry .entry-title, .report-entry .entry-chevron { color: #8b5b15; }
.report-entry .entry-note { color: #806640; }
.report-pill { flex: none; padding: 6rpx 12rpx; border: 1rpx solid #e7ce94; border-radius: 8rpx; color: #8b5b15; font-size: 20rpx; font-weight: 400; }
.profile-tools { margin-top: 24rpx; border: 1rpx solid #e4eaf3; border-radius: 22rpx; overflow: hidden; }
.profile-tools .profile-entry + .profile-entry { border-top: 1rpx solid #edf1f7; }
.trash-icon { color: #64748b; }
.profile-footnote { display: block; margin-top: 28rpx; color: #75849a; text-align: center; font-size: 23rpx; }
