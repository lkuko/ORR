<view class="page profile-page">
  <view wx:if="{{user}}" class="profile-header"><view class="profile-initial">{{user.initial}}</view><view class="profile-copy"><text class="profile-name">{{user.nickname}}</text><text class="profile-note">我的校园生活</text></view><button class="edit-profile" bindtap="editNickname" aria-label="修改昵称"><text class="cuIcon-edit"></text>编辑</button></view>
  <empty-state wx:elif="{{error}}" title="暂时无法登录" description="{{error}}" button-text="重新登录" bind:action="onShow" />
  <view wx:else class="loading-panel"><text class="loading-label">正在读取你的信息…</text></view>
  <view class="profile-orders"><view class="section-heading"><text>我的订单</text></view><view class="order-shortcuts">
    <button class="order-shortcut" data-kind="market" bindtap="openOrders"><view class="shortcut-icon"><text class="cuIcon-shop"></text></view><view><text class="shortcut-title">二手订单</text><text class="shortcut-note">我买到的 / 我卖出的</text></view><text class="entry-chevron">›</text></button>
    <button class="order-shortcut" data-kind="tasks" bindtap="openOrders"><view class="shortcut-icon"><text class="cuIcon-deliver"></text></view><view><text class="shortcut-title">跑腿订单</text><text class="shortcut-note">我发布的 / 我接单的</text></view><text class="entry-chevron">›</text></button>
  </view></view>
  <button class="profile-entry report-entry" bindtap="openReports"><view class="entry-icon"><text class="cuIcon-warn"></text></view><view class="entry-copy"><text class="entry-title">我的举报</text><text class="entry-note">查看处理进度与结果</text></view><text class="report-pill">进度查询</text><text class="entry-chevron">›</text></button>
  <view class="profile-tools">
    <button class="profile-entry" data-mode="mine" bindtap="openProducts"><view class="entry-icon"><text class="cuIcon-goods"></text></view><view class="entry-copy"><text class="entry-title">我发布的商品</text><text class="entry-note">管理在售、已售与下架商品</text></view><text class="entry-chevron">›</text></button>
    <button class="profile-entry" data-mode="favorites" bindtap="openProducts"><view class="entry-icon"><text class="cuIcon-favor"></text></view><view class="entry-copy"><text class="entry-title">我的收藏</text><text class="entry-note">收藏的校园好物</text></view><text class="entry-chevron">›</text></button>
    <button class="profile-entry" bindtap="openTrash"><view class="entry-icon trash-icon"><text class="cuIcon-delete"></text></view><view class="entry-copy"><text class="entry-title">回收站</text><text class="entry-note">恢复或清理订单、举报记录</text></view><text class="entry-chevron">›</text></button>
  </view>
  <text class="profile-footnote">当面交付更安心，沟通请保留订单留言。</text>
</view>
