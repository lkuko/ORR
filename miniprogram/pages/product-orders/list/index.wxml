<view class="market-page">
  <view class="market-heading"><view><text class="market-title">二手交易</text><text class="market-note">约好时间，当面交付；历史记录随时查看。</text></view></view>
  <view class="market-sort role-switch"><button class="{{role === 'buyer' ? 'selected' : ''}}" data-role="buyer" bindtap="selectRole">我买到的</button><button class="{{role === 'seller' ? 'selected' : ''}}" data-role="seller" bindtap="selectRole">我卖出的</button></view>
  <view class="record-filters"><button wx:for="{{filters}}" wx:key="value" class="{{view === 'list' && status === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectStatus">{{item.label}}</button><button class="{{view === 'trash' ? 'selected' : ''}}" data-view="trash" bindtap="selectView"><text class="cuIcon-delete"></text> 回收站</button></view>
  <text wx:if="{{view === 'trash'}}" class="market-note trash-note">删除时可选 7 天或 30 天保留期，到期后无法恢复。仅影响你自己的记录。</text>
  <view wx:if="{{loading && !orders.length}}" class="loading-panel"><text class="loading-label">正在读取交易…</text></view>
  <empty-state wx:elif="{{error && !orders.length}}" title="暂时未能读取订单" description="{{error}}" button-text="重试" bind:action="load"/>
  <empty-state wx:elif="{{!orders.length}}" title="{{view === 'trash' ? '回收站是空的' : '这里还没有交易订单'}}" description="{{view === 'trash' ? '在保留期内，你可以从这里恢复已删除的记录。' : '预约商品或收到买家预约后，可以在这里跟进。'}}" button-text="{{view === 'trash' ? '' : '逛逛校园二手'}}" bind:action="discover"/>
  <view wx:for="{{orders}}" wx:key="id" class="market-section order-row">
    <view data-id="{{item.id}}" bindtap="open" role="button" aria-label="查看{{item.title}}订单">
      <view class="order-heading"><text class="order-title">{{item.title}}</text><text class="cu-tag bg-blue light">{{item.statusLabel}}</text></view>
      <text class="market-price">¥{{item.price}}</text><text class="market-note">{{role === 'buyer' ? '卖家：' + item.sellerNickname : '买家：' + item.buyerNickname}}</text>
      <text class="order-hint">{{view === 'trash' ? '保留至 ' + item.expiresLabel : item.hint}}</text>
      <view class="market-meta"><text>{{view === 'trash' ? '删除于 ' + item.archivedLabel : item.createdLabel}}</text><text>{{item.number}}</text></view>
    </view>
    <view class="record-actions"><button wx:if="{{item.canArchive}}" class="text-button" data-id="{{item.id}}" bindtap="archive" disabled="{{!!busyId}}">删除记录</button><button wx:if="{{view === 'trash'}}" class="text-button restore-link" data-id="{{item.id}}" bindtap="restore" disabled="{{!!busyId}}" loading="{{busyId === item.id}}">恢复记录</button><button class="text-button open-order" data-id="{{item.id}}" bindtap="open">{{item.active ? '进入交易' : '查看详情'}} <text class="cuIcon-right"></text></button></view>
  </view>
  <text wx:if="{{error && orders.length}}" class="error-text">{{error}}</text>
  <view class="market-more"><button wx:if="{{cursor}}" class="cu-btn bg-white" disabled="{{loading}}" loading="{{loading}}" bindtap="loadMore">加载更多</button></view>
</view>
