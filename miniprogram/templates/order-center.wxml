<view class="page order-center">
  <view class="center-heading"><text class="page-title">{{trashOnly ? '回收站' : '订单'}}</text><text class="page-subtitle">{{trashOnly ? '已删除的订单和举报，统一恢复或清理。' : '买卖进度、跑腿安排，一处查看。'}}</text></view>
  <view class="order-controls">
    <view class="kind-tabs" wx:if="{{!trashOnly}}">
      <button class="kind-tab {{kind === 'market' ? 'selected' : ''}}" data-kind="market" bindtap="selectKind" disabled="{{!!busyId}}"><text class="cuIcon-shop"></text>二手订单</button>
      <button class="kind-tab {{kind === 'tasks' ? 'selected' : ''}}" data-kind="tasks" bindtap="selectKind" disabled="{{!!busyId}}"><text class="cuIcon-deliver"></text>跑腿订单</button>
    </view>
    <view class="kind-tabs" wx:else>
      <button class="kind-tab {{kind === 'market' ? 'selected' : ''}}" data-kind="market" bindtap="selectKind" disabled="{{!!busyId}}">二手订单</button>
      <button class="kind-tab {{kind === 'reports' ? 'selected' : ''}}" data-kind="reports" bindtap="selectKind" disabled="{{!!busyId}}">举报记录</button>
    </view>
    <view class="role-tabs" wx:if="{{kind === 'market'}}"><button class="{{role === 'buyer' ? 'selected' : ''}}" data-role="buyer" bindtap="selectRole" disabled="{{!!busyId}}">我买到的</button><button class="{{role === 'seller' ? 'selected' : ''}}" data-role="seller" bindtap="selectRole" disabled="{{!!busyId}}">我卖出的</button></view>
    <view class="role-tabs" wx:elif="{{kind === 'tasks'}}"><button class="{{role === 'owner' ? 'selected' : ''}}" data-role="owner" bindtap="selectRole" disabled="{{!!busyId}}">我发布的</button><button class="{{role === 'helper' ? 'selected' : ''}}" data-role="helper" bindtap="selectRole" disabled="{{!!busyId}}">我接单的</button></view>
    <view class="status-tabs" wx:if="{{!trashOnly}}"><button wx:for="{{filters}}" wx:key="value" class="{{status === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectStatus" disabled="{{!!busyId}}">{{item.label}}</button></view>
  </view>
  <view wx:if="{{trashOnly && kind === 'market'}}" class="trash-toolbar"><view><text class="toolbar-title">{{role === 'buyer' ? '我买到的' : '我卖出的'}}回收记录</text><text class="toolbar-note">左滑单条清理，清理后无法恢复。</text></view><button class="clear-all" bindtap="clearAll" disabled="{{!!busyId || loading || !orders.length}}" loading="{{busyId === 'all'}}">全部清理</button></view>
  <view wx:if="{{busyId === 'all' && kind !== 'reports'}}" class="cleanup-progress">正在清理，已完成 {{cleanupCount}} 条…</view>
  <block wx:if="{{kind === 'market'}}">
    <view wx:if="{{loading && !orders.length}}" class="loading-panel"><text class="loading-label">正在读取订单…</text></view>
    <empty-state wx:elif="{{error && !orders.length}}" title="暂时未能读取订单" description="{{error}}" button-text="重试" bind:action="load" />
    <empty-state wx:elif="{{!orders.length}}" title="{{trashOnly ? '回收站是空的' : '这里还没有订单'}}" description="{{trashOnly ? '删除订单时可选保留 7 天或 30 天。' : (status === 'all' ? '预约商品后，买卖双方都能在这里跟进。' : '这个状态下暂时没有订单，可切换其他状态查看。')}}" button-text="{{trashOnly ? '' : '逛逛校园二手'}}" bind:action="discover" />
    <swipe-row wx:for="{{orders}}" wx:key="id" record-id="{{item.id}}" enabled="{{trashOnly}}" open="{{swipeId === item.id}}" disabled="{{!!busyId}}" bind:reveal="reveal" bind:close="closeSwipe" bind:swiping="swiping" bind:clear="clearOne">
      <view class="order-card">
        <view class="order-main" data-id="{{item.id}}" bindtap="open" role="button" aria-label="查看{{item.title}}订单">
          <view class="order-top"><text class="order-number">编号 {{item.number}}</text><text class="trade-status status-{{item.status}}">{{item.statusLabel}}</text></view>
          <view class="order-title-row"><text class="order-title">{{item.title}}</text><text class="order-price">¥{{item.price}}</text></view>
          <text class="order-person">{{role === 'buyer' ? '卖家：' + item.sellerNickname : '买家：' + item.buyerNickname}}</text>
          <view class="order-next {{trashOnly ? 'archive-hint' : ''}}"><text>{{trashOnly ? '可恢复至 ' + item.expiresLabel : item.hint}}</text></view>
        </view>
        <view class="order-footer"><text class="order-date">{{trashOnly ? '保留 ' + item.retentionDays + ' 天' : item.createdLabel}}</text><view class="order-actions">
          <button wx:if="{{item.canArchive}}" class="quiet-action" data-id="{{item.id}}" bindtap="archive" disabled="{{!!busyId}}" loading="{{busyId === item.id}}">删除记录</button>
          <block wx:if="{{trashOnly}}"><button class="quiet-action danger-link" data-id="{{item.id}}" bindtap="clearOne" disabled="{{!!busyId}}">清理</button><button class="order-cta secondary-cta" data-id="{{item.id}}" bindtap="restore" disabled="{{!!busyId}}" loading="{{busyId === item.id}}">恢复记录</button></block>
          <button wx:else class="order-cta {{item.active ? '' : 'secondary-cta'}}" data-id="{{item.id}}" bindtap="open" disabled="{{!!busyId}}">{{item.canRespond ? '处理取消' : item.active ? '进入交易' : '查看详情'}}<text class="cuIcon-right"></text></button>
        </view></view>
      </view>
    </swipe-row>
    <text wx:if="{{error && orders.length}}" class="error-text">{{error}}</text><button wx:if="{{cursor}}" class="load-more" disabled="{{loading || !!busyId}}" loading="{{loading}}" bindtap="loadMore">加载更多</button>
  </block>
  <view wx:elif="{{kind === 'reports'}}" class="reports-page"><include src="./report-records.wxml" /></view>
  <block wx:else>
    <view wx:if="{{loading && !tasks.length}}" class="loading-panel"><text class="loading-label">正在读取订单…</text></view>
    <empty-state wx:elif="{{error}}" title="暂时未能读取订单" description="{{error}}" button-text="重试" bind:action="load" />
    <empty-state wx:elif="{{!tasks.length}}" title="这里还没有订单" description="{{status === 'all' ? '发布需求或接下任务后，可以在这里跟进进度。' : '这个状态下暂时没有订单，可切换其他状态查看。'}}" button-text="{{role === 'owner' ? '发布任务' : '去跑腿大厅'}}" bind:action="emptyAction" />
    <view wx:for="{{tasks}}" wx:key="id" class="order-card task-card" data-id="{{item.id}}" bindtap="openTask" hover-class="button-pressed" role="button" aria-label="查看{{item.title}}订单">
      <view class="order-main"><view class="order-top"><text class="order-number">编号 {{item.orderNumber}}</text><status-tag status="{{item.status}}" /></view><view class="order-title-row"><text class="order-title">{{item.title}}</text><text class="order-price">{{item.rewardLabel}}</text></view><text class="order-person">{{item.publicArea}}</text><view class="order-next"><text>{{item.nextHint}}</text></view></view><view class="task-footer"><text>查看订单</text><text class="cuIcon-right"></text></view>
    </view>
  </block>
</view>
