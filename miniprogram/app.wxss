page { min-height: 100%; background: #f5f7f6; color: #203137; font-family: "PingFang SC", "Microsoft YaHei", -apple-system, sans-serif; font-size: 28rpx; line-height: 1.55; }
view, text, input, textarea, button, picker { box-sizing: border-box; }
button { margin: 0; padding: 22rpx 28rpx; min-height: 88rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.page button { margin-left: 0; margin-right: 0; }
button::after { border: 0; }
button[disabled] { background: #e3e8f3 !important; color: #69768e !important; }
button:focus-visible { outline: 4rpx solid #8ca5ef; outline-offset: 4rpx; }
.button-pressed { opacity: .76; }
.page { min-height: 100vh; padding: 28rpx 32rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.page-title { display: block; font-size: 44rpx; font-weight: 700; line-height: 1.25; }
.page-subtitle { display: block; margin-top: 12rpx; color: #66738a; font-size: 25rpx; line-height: 1.6; }
.section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx 16rpx; margin: 36rpx 0 20rpx; font-size: 31rpx; font-weight: 700; }
.section-heading .muted { font-size: 24rpx; font-weight: 400; }
.surface { padding: 28rpx; border: 1rpx solid #e1e7e5; border-radius: 16rpx; background: #ffffff; }
.muted { color: #66738a; }
.primary-button { color: #ffffff; background: #2854d9; }
.secondary-button { color: #244dbf; background: #e9efff; }
.danger-button { color: #aa3e3e; background: #fff0ef; }
.text-button { display: inline-flex; align-items: center; justify-content: center; padding: 14rpx 4rpx; min-height: 72rpx; color: #2854d9; background: transparent; font-size: 25rpx; }
.field { margin-top: 28rpx; }
.field:first-child { margin-top: 0; }
.field-label { display: block; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 600; }
.field-input, .field-area, .field-select { width: 100%; border: 2rpx solid #e0e6f0; border-radius: 14rpx; background: #f8faff; color: #182744; font-size: 28rpx; }
.field-input { height: 94rpx; padding: 0 22rpx; }
.field-area { padding: 22rpx; min-height: 200rpx; line-height: 1.65; }
.field-select { min-height: 94rpx; padding: 24rpx 22rpx; }
.field-hint { display: block; margin-top: 10rpx; color: #66738a; font-size: 23rpx; line-height: 1.6; }
.field-input:focus, .field-area:focus { border-color: #2854d9; }
.action-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.action-row button { flex: 1; min-width: 0; }
.empty-state { padding: 64rpx 28rpx; color: #66738a; text-align: center; }
.error-text { color: #a73b3b; font-size: 25rpx; }
.hero-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.hero-row > view { min-width: 0; flex: 1; }
.compact-button { flex: none; padding: 18rpx 26rpx; font-size: 26rpx; }
.hero-row button.compact-button { width: auto; }
.loading-panel { padding: 36rpx 28rpx; background: #fff; border-radius: 16rpx; }
.loading-line { height: 24rpx; margin: 16rpx 0; width: 72%; border-radius: 8rpx; background: #ebefed; }
.loading-line.short { width: 42%; }
.loading-label { display: block; margin-top: 24rpx; font-size: 24rpx; color: #66738a; }
.avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 22rpx; background: #eaf0ff; color: #2854d9; font-size: 27rpx; font-weight: 700; }
.form-section { margin-top: 24rpx; }
.form-section-title { display: block; margin-bottom: 26rpx; font-size: 30rpx; font-weight: 700; }
.submit-button { margin-top: 28rpx; width: 100%; }
.page button.submit-button { width: 100%; margin: 28rpx 0 0; }
.form-note { display: block; margin-top: 18rpx; color: #66738a; font-size: 23rpx; text-align: center; line-height: 1.65; }
.page text { overflow-wrap: anywhere; }
.inline-composer { display: flex; align-items: flex-end; gap: 14rpx; }
.inline-composer .composer-input { flex: 1; width: 0; min-width: 0; height: 88rpx; padding: 0 20rpx; border: 2rpx solid #dfe5f0; border-radius: 12rpx; background: #f8faff; font-size: 26rpx; }
.page .inline-composer .composer-send { display: flex; align-items: center; justify-content: center; flex: 0 0 132rpx; width: 132rpx; min-width: 0; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; border-radius: 12rpx; font-size: 26rpx; line-height: 1.4; }
