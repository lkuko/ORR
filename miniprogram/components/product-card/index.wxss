@import "../../vendor/colorui/icon.wxss";
.product-card { overflow: hidden; border-radius: 16rpx; background: #fff; border: 1rpx solid #e1e7e5; }
.product-cover { display: block; width: 100%; height: 304rpx; background: #e8edee; }
.product-placeholder { display: flex; flex-direction: column; gap: 16rpx; align-items: center; justify-content: center; color: #66738a; font-size: 22rpx; }
.product-placeholder text:first-child { font-size: 56rpx; }
.product-body { padding: 20rpx 20rpx 0; }
.product-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 80rpx; line-height: 40rpx; font-size: 28rpx; font-weight: 600; word-break: break-all; }
.product-tags { display: flex; gap: 8rpx; flex-wrap: wrap; min-height: 40rpx; margin: 8rpx 0; }
.product-tags text { color: #52617a; background: #f1f4f8; padding: 2rpx 8rpx; border-radius: 4rpx; font-size: 20rpx; }
.product-price { display: block; color: #b7452b; font-size: 34rpx; line-height: 1.4; font-weight: 700; }
.product-area { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 22rpx; margin-top: 8rpx; color: #66738a; }
.product-bottom { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 12rpx 8rpx 20rpx; }
.product-seller { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #66738a; font-size: 21rpx; }
.product-favorite { display: flex; align-items: center; justify-content: center; flex: none; width: auto; gap: 8rpx; min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 8rpx; line-height: 1.4; font-size: 22rpx; border: 0; border-radius: 12rpx; background: transparent; color: #66738a; }
.product-favorite::after { border: 0; }
.product-card .product-favorite { width: auto; }
.product-favorite text:first-child { font-size: 32rpx; }
.product-favorite.selected { color: #2854d9; }
.pressed { opacity: .8; }
