@import "../../vendor/colorui/icon.wxss";
:host { display: block; min-width: 0; height: 100%; }
.product-card { height: 100%; overflow: hidden; border-radius: 20rpx; background: #fff; border: 1rpx solid #e4eaf3; }
.product-cover { display: block; width: 100%; height: 300rpx; background: #edf1f7; }
.product-placeholder { display: flex; flex-direction: column; gap: 16rpx; align-items: center; justify-content: center; color: #64748b; font-size: 22rpx; }
.product-placeholder text:first-child { font-size: 56rpx; }
.product-body { padding: 18rpx 20rpx 0; }
.product-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 80rpx; line-height: 40rpx; font-size: 28rpx; font-weight: 600; color: #152c48; word-break: break-all; }
.product-tags { display: flex; align-items: center; gap: 8rpx; flex-wrap: nowrap; height: 40rpx; overflow: hidden; margin: 8rpx 0; }
.product-tags text { flex: 0 1 auto; min-width: 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #52617a; background: #f1f5fb; padding: 3rpx 8rpx; border-radius: 6rpx; font-size: 20rpx; line-height: 30rpx; }
.product-price { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; height: 48rpx; color: #b7452b; font-size: 34rpx; line-height: 48rpx; font-weight: 700; }
.price-unavailable { color: #75849a; font-size: 24rpx; font-weight: 400; }
.product-area { display: block; height: 34rpx; line-height: 34rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 22rpx; margin-top: 8rpx; color: #64748b; }
.product-bottom { display: flex; align-items: center; gap: 8rpx; box-sizing: border-box; height: 100rpx; padding: 6rpx 12rpx 6rpx 20rpx; }
.product-seller { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #64748b; font-size: 21rpx; }
.product-favorite { display: flex; align-items: center; justify-content: center; flex: none; width: auto; gap: 8rpx; min-width: 88rpx; height: 88rpx; margin: 0; padding: 8rpx; line-height: 1.4; font-size: 22rpx; border: 0; border-radius: 12rpx; background: transparent; color: #64748b; }
.product-favorite::after { border: 0; }
.product-card .product-favorite { width: auto; }
.product-favorite text:first-child { font-size: 32rpx; }
.product-favorite.selected { color: #2854d9; }
.pressed { opacity: .8; }
