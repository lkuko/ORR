:host { display: block; min-width: 0; margin-bottom: 20rpx; }
.swipe-row { position: relative; overflow: hidden; border-radius: 22rpx; }
.swipe-clear { position: absolute; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: 160rpx; margin: 0; padding: 16rpx; border-radius: 0; background: #b64343; color: #fff; font-size: 28rpx; font-weight: 600; }
.swipe-clear::after { border: 0; }
.swipe-clear[disabled] { background: #e8c9c9; color: #865858; }
.swipe-content { position: relative; z-index: 1; background: #fff; border-radius: 22rpx; transition: transform .18s ease-out; touch-action: pan-y; }
.swipe-content.is-dragging { transition: none; }
@media (prefers-reduced-motion: reduce) { .swipe-content { transition: none; } }
